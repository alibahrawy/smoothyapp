{
  "manifestVersion": 5,
  "id": "com.smoothyedit.uxp.bridge",
  "name": "SmoothyEdit Bridge",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.2.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "smoothyeditBridge",
      "label": {
        "default": "SmoothyEdit Bridge"
      },
      "minimumSize": {
        "width": 240,
        "height": 180
      },
      "preferredDockedSize": {
        "width": 300,
        "height": 240
      },
      "preferredFloatingSize": {
        "width": 320,
        "height": 260
      }
    },
    {
      "type": "command",
      "id": "refreshSequenceInfo",
      "label": {
        "default": "SmoothyEdit: Refresh Sequence"
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": [
        "ws://localhost:3456",
        "ws://localhost:3457",
        "http://localhost:3456"
      ]
    },
    "localFileSystem": "request",
    "clipboard": "readAndWrite"
  },
  "featureFlags": {
    "enableSWCSupport": true,
    "enableAlerts": true
  }
}
