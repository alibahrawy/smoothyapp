{
  "name": "smoothyedit",
  "version": "1.3.4",
  "description": "SmoothyEdit - AI-powered multicam editing for Premiere Pro",
  "main": "out/main/index.js",
  "author": "SmoothyEdit",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "generate-icons": "node scripts/generate-icons.js",
    "build:win": "npm run generate-icons && npm run build && electron-builder --win --config",
    "build:mac": "npm run generate-icons && npm run build && electron-builder --mac --config",
    "build:publish:mac": "npm run generate-icons && npm run build && electron-builder --mac --publish always --config",
    "build:publish:win": "npm run generate-icons && npm run build && electron-builder --win --publish always --config"
  },
  "dependencies": {
    "@fugood/whisper.node": "^1.0.15",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.7.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "electron": "^41.1.0",
    "electron-builder": "^24.9.1",
    "electron-icon-builder": "^2.0.1",
    "electron-vite": "^2.0.0",
    "sharp": "^0.34.5",
    "vite": "^5.0.0"
  },
  "build": {
    "appId": "com.smoothyedit.app",
    "afterPack": "build/after-pack.js",
    "publish": {
      "provider": "github",
      "owner": "alibahrawy",
      "repo": "smoothyapp"
    },
    "productName": "SmoothyEdit",
    "copyright": "Copyright 2024 SmoothyEdit",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "node_modules/ffmpeg-static/**/*",
      "node_modules/ffprobe-static/**/*",
      "node_modules/@fugood/whisper.node/**/*",
      "node_modules/@fugood/node-whisper-*/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "node_modules/ffprobe-static/**/*",
      "node_modules/@fugood/whisper.node/**/*",
      "node_modules/@fugood/node-whisper-*/**/*"
    ],
    "extraResources": [
      {
        "from": "../smoothyapp-cep",
        "to": "cep-plugin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "SmoothyEdit-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SmoothyEdit",
      "include": "build/installer.nsh",
      "warningsAsErrors": false,
      "deleteAppDataOnUninstall": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.video",
      "artifactName": "SmoothyEdit-${version}-mac.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false
    }
  }
}
